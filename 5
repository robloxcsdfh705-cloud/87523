import { Buffer } from 'node:buffer';

function hexToUint8Array(hex) {
  const match = hex.match(/.{1,2}/g);
  return match ? new Uint8Array(match.map(b => parseInt(b, 16))) : new Uint8Array(0);
}

function generate6CharSvgCaptcha() {
  const chars = '23456789ABCDEFGHJKLMNPQRSTUVWXYZ';
  let code = '';
  for (let i = 0; i < 6; i++) {
    code += chars.charAt(Math.floor(Math.random() * chars.length));
  }

  let lines = '';
  for (let i = 0; i < 7; i++) {
    const x1 = Math.floor(Math.random() * 200);
    const y1 = Math.floor(Math.random() * 60);
    const x2 = Math.floor(Math.random() * 200);
    const y2 = Math.floor(Math.random() * 60);
    const colors = ['#f97316', '#06b6d4', '#10b981', '#a855f7', '#ec4899'];
    lines += `<line x1="${x1}" y1="${y1}" x2="${x2}" y2="${y2}" stroke="${colors[i % colors.length]}" stroke-width="1.5" opacity="0.6"/>`;
  }

  let textSvg = '';
  for (let i = 0; i < 6; i++) {
    const x = 20 + i * 28;
    const y = 38 + (Math.random() * 8 - 4);
    const rot = Math.floor(Math.random() * 30 - 15);
    textSvg += `<text x="${x}" y="${y}" fill="#06b6d4" font-size="26" font-family="monospace" font-weight="bold" transform="rotate(${rot}, ${x}, ${y})">${code[i]}</text>`;
  }

  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="200" height="60" viewBox="0 0 200 60" style="background:#090d16; border-radius:12px;"><rect width="100%" height="100%" fill="#090d16"/>${lines}${textSvg}</svg>`;
  const base64Svg = Buffer.from(svg).toString('base64');
  return { code, dataUrl: `data:image/svg+xml;base64,${base64Svg}` };
}

async function verifySignature(request, publicKey) {
  const signature = request.headers.get('X-Signature-Ed25519');
  const timestamp = request.headers.get('X-Signature-Timestamp');
  const body = await request.text();

  if (!signature || !timestamp || !publicKey) return { isValid: false, rawBody: body };

  try {
    const key = await crypto.subtle.importKey(
      'raw',
      hexToUint8Array(publicKey),
      { name: 'NODE-ED25519', namedCurve: 'NODE-ED25519' },
      true,
      ['verify']
    );

    const isValid = await crypto.subtle.verify(
      'NODE-ED25519',
      key,
      hexToUint8Array(signature),
      new TextEncoder().encode(timestamp + body)
    );

    return { isValid, rawBody: body };
  } catch (err) {
    return { isValid: false, rawBody: body };
  }
}

